{
  "name": "LocalPDF",
  "short_name": "LocalPDF",
  "description": "Free and Secure Client-Side PDF Tools. Process files 100% locally in your browser.",
  "theme_color": "#070714",
  "background_color": "#070714",
  "display": "standalone",
  "orientation": "any",
  "start_url": "/",
  "file_handlers": [
    {
      "action": "/?source=file-handler",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
